// TypeSpec grammar — M5b (ADR 0006 D2/D5/D6/D7, ADR 0004 D7).
//
// Scope (plan 03 M5b): file skeleton, import/using/namespace statements
// (namespace both block and blockless), and model declarations with
// extends/is/spread/optional properties/template parameter LISTS. Template
// *arguments* in type position (`Page<Pet>`) and every other declaration kind
// (op/interface/enum/union/alias/scalar, decorators, type expressions) are
// explicitly M5c — see docs/plans/03-grammar-and-psi.md.
//
// `methods=[...]` and `psiImplUtilClass` are BANNED in this file (ADR 0006
// D7/F8): both resolve via Grammar-Kit's `AsmHelper` against the generator's
// own classpath, which cannot contain classes this Gradle build has not
// compiled yet. Every named declaration instead uses `mixin=` (a hand-written
// Kotlin base class, referenced only as a string — Grammar-Kit emits an
// `extends` clause and never loads it) plus `implements=` (a hand-written
// interface). See psi/impl/TypeSpecNamedElementMixin.kt.
{
  parserClass="simpli.fyi.plugins.typespec.parser.TypeSpecParser"
  parserUtilClass="com.intellij.lang.parser.GeneratedParserUtilBase"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="TypeSpec"
  psiImplClassSuffix="Impl"
  psiPackage="simpli.fyi.plugins.typespec.psi"
  psiImplPackage="simpli.fyi.plugins.typespec.psi.impl"

  // ADR 0006 F11: named "TypeSpecTypes" (Grammar-Kit's own "<Lang>Types" convention),
  // deliberately NOT "TypeSpecElementTypes" — that name is the hand-written
  // IFileElementType holder (TypeSpecElementTypes.FILE), untouched by this milestone.
  elementTypeHolderClass="simpli.fyi.plugins.typespec.psi.TypeSpecTypes"
  elementTypeClass="simpli.fyi.plugins.typespec.psi.TypeSpecElementType"
  tokenTypeClass="simpli.fyi.plugins.typespec.psi.TypeSpecTokenType"
  // ADR 0006 D5/F6: bridges generated token-type constants to the *same* IElementType
  // instances the hand-written JFlex lexer already emits, instead of minting new ones.
  tokenTypeFactory="simpli.fyi.plugins.typespec.psi.TypeSpecTokenTypes.fromNameOrText"

  generateTokenAccessors=true

  // Only the two "external" tokens this milestone's rules need by name: STRING
  // (import target) and IDENTIFIER (every name, ordinary or backticked — the
  // hand-written lexer returns the same IDENTIFIER token type for both, see
  // _TypeSpecLexer.flex). Keyword and punctuation literals below (e.g. 'model',
  // ';', '?') are deliberately left as bare string literals, NOT declared here:
  // empirically verified (M5b spike) that undeclared literals compile to
  // GeneratedParserUtilBase's TEXT-based `consumeToken(builder, "model")`, which
  // matches the source text directly and works correctly even though the
  // hand-written lexer returns one shared KEYWORD IElementType for every
  // keyword (ADR 0001) — declaring them here instead would route them through
  // `tokenTypeFactory` for per-literal IElementType identity, which the shared
  // KEYWORD token cannot support (identical instances for 'model' and
  // 'namespace' alike) and would silently break keyword disambiguation.
  tokens=[
    IDENTIFIER='regexp:[A-Za-z_][A-Za-z0-9_]*'
    STRING='regexp:"[^"]*"'
    NUMBER='regexp:[0-9]+'
    KEYWORD='regexp:[a-z]+'
    // M5c: decorator/augment-decorator applications. Unlike the punctuation
    // literals below (fixed text, matched by GeneratedParserUtilBase's TEXT-based
    // consumeToken), `@Ns.name` / `@@Ns.name` have *variable* text per
    // application, so they must be recognised purely by token *type* — hence
    // declared here (as IDENTIFIER/STRING/NUMBER/KEYWORD already are) and
    // referenced bare (`DECORATOR`, `AUGMENT_DECORATOR`) rather than quoted. The
    // hand-written lexer already emits one whole `@Ns.name` as a single DECORATOR
    // token (ADR 0004 F6) — this grammar wraps that one token, it does not split
    // it. The regexps below are never actually exercised (the hand-written lexer
    // is used at runtime, same as every other declared token here); they only
    // satisfy Grammar-Kit's own internal preview lexer.
    DECORATOR='regexp:@[A-Za-z_][A-Za-z0-9_.]*'
    AUGMENT_DECORATOR='regexp:@@[A-Za-z_][A-Za-z0-9_.]*'
    // M5c: a *single* source string literal containing an escape sequence
    // (`"hi\nthere"`) is lexed by the hand-written lexer as MULTIPLE leaf
    // tokens — STRING, then alternating VALID_ESCAPE/INVALID_ESCAPE/STRING —
    // never one token (`_TypeSpecLexer.flex`'s `STRING_S` state; this is an M2
    // lexer decision, not something this milestone changes). Every grammar rule
    // that consumes "a string literal" must therefore consume the whole
    // `STRING (VALID_ESCAPE | INVALID_ESCAPE | STRING)*` run, not a bare
    // `STRING` alone, or any escaped string (e.g. `alias Greeting = "hi\nthere";`
    // from kitchen-sink.tsp line 31) leaves a dangling leftover token and a
    // PsiErrorElement. Declared here (as DECORATOR/AUGMENT_DECORATOR already
    // are) purely so they can be referenced bare below.
    VALID_ESCAPE='regexp:\\[^]'
    INVALID_ESCAPE='regexp:\\[^]'
    // M6c row 4: `"""..."""` triple-quoted multi-line strings. Unlike STRING's
    // STRING_S escape-run state, `_TypeSpecLexer.flex`'s YYINITIAL rule for a
    // *terminated* `"""..."""` (line 53) matches the whole literal — open
    // quotes, body (including embedded newlines: `[^\"]` is not
    // newline-exclusive), close quotes — in one shot and returns a SINGLE
    // MULTILINE_STRING token; the MULTILINE_STRING_S state (line 54/197-200)
    // is reached only for an *unterminated* literal running to EOF. Verified
    // by reading the actual token stream (TypeSpecLexerTest), not assumed:
    // every well-formed triple-quoted literal in the corpus is one token, so
    // `literal_type` below needs a bare `MULTILINE_STRING`, not a `+` run.
    MULTILINE_STRING='regexp:\"\"\"([^\"]|\"[^\"]|\"\"[^\"])*\"\"\"'
  ]
}

// The top-level rule never gets its own PSI class or element type: Grammar-Kit
// inlines it directly under the `root` IElementType the platform supplies
// (TypeSpecElementTypes.FILE, via ParserDefinition.getFileNodeType() /
// TypeSpecParser.parseLight's `exit_section_(..., root_, ...)`) — verified
// empirically against a scratch grammar before writing this file (ADR 0006 F7).
typespec_file ::= top_level_item_*

private top_level_item_ ::= import_statement | using_statement | namespace_statement | model_statement
  | op_statement | interface_statement | enum_statement | union_statement | alias_statement
  | scalar_statement | augment_decorator_statement | bad_top_level_token_

// ADR 0006 D6: no `recoverWhile` here, deliberately. `recoverWhile`'s built-in
// skip mechanism re-checks its predicate even *after* a successful match of the
// attributed rule/choice (Grammar-Kit's `exit_section_impl_`), and for a choice
// whose last alternative (`bad_top_level_token_` below) can itself start with
// almost any token, that post-success re-check spuriously reports the
// just-consumed token as "unexpected" as soon as the *next* token isn't in the
// stop set — corrupting an otherwise-successful parse (empirically verified: a
// plain identifier property immediately after a broken one got wrapped in a
// bogus `PsiErrorElement` this way). The explicit `bad_top_level_token_`
// fallback alternative below is what actually provides forward progress
// through pure garbage; recovery here does not need `recoverWhile` at all —
// `model_member_` further down uses the identical fallback-alternative
// technique (and the identical "no recoverWhile" reasoning) for the
// model-property loop.
private bad_top_level_token_ ::= bad_top_level_guard_ (IDENTIFIER | STRING | NUMBER | KEYWORD | DECORATOR | AUGMENT_DECORATOR
  | ';' | '.' | ',' | ':' | '<' | '>' | '=' | '&' | '|' | '?' | '!' | '+' | '-' | '*' | '/' | '(' | ')' | '[' | ']' | '...')

// Stop set: '}' (leave an enclosing namespace block's own closing brace for
// `namespace_block_` to consume) and the keyword that starts each known
// top-level construct (so those are tried as *real* alternatives above, not
// swallowed as garbage). Orphan ';' is deliberately NOT excluded — it is safe
// to eat as garbage here since it terminates nothing on its own.
private bad_top_level_guard_ ::= !('}' | 'model' | 'namespace' | 'using' | 'import'
  | 'op' | 'interface' | 'enum' | 'union' | 'alias' | 'scalar')

import_statement ::= 'import' STRING ';' {
  pin=1
}

using_statement ::= 'using' qualified_name ';' {
  pin=1
}

// Blockless `namespace Foo;` covers the rest of the file (TypeSpec sugar for a
// namespace containing everything after it). Expressed here as containment —
// the trailing top-level items become direct children of this same
// namespace_statement node — so TypeSpecFile.getFileNamespace() is a trivial
// "find the first namespace_statement child of the file" query, and
// getTopLevelDeclarations() naturally stops at the blockless namespace's ';'
// (ADR 0004 D7.4, plan 03 M5b risk note).
namespace_statement ::= decorator_application* 'namespace' qualified_name (namespace_block_ | (';' top_level_item_*)) {
  pin=2
  mixin="simpli.fyi.plugins.typespec.psi.impl.TypeSpecNamedElementMixin"
  implements="simpli.fyi.plugins.typespec.psi.TypeSpecNamedElement"
}

private namespace_block_ ::= '{' top_level_item_* '}'

// Plan 04 M6c row 3 / ADR 0007 D9: repointed from "extends_clause? is_clause?
// model_body" (which forced a body after `is` too) to two separate
// alternatives, matching the shipped compiler's `parseModelStatement` exactly
// (ADR 0007 primary-source facts table): `is` alone admits EITHER `;` OR a
// body (`model X is Y;` and `model X is Y { ... }` are both valid, 23+ corpus
// occurrences of the former, `@typespec/http/lib/streams/main.tsp`'s
// `JsonlStream` the latter); `extends` (or neither) still REQUIRES a body —
// `model M extends Foo;` stays a `PsiErrorElement` (ModelExtendsNoBodyIsError.tsp
// locks this). Do NOT collapse this back into a single optional `model_body?`
// on one shared clause — that would legalise `extends ... ;` too, which is not
// valid TypeSpec. `pin=2` is unaffected: it still marks 'model' itself, the
// point of no return, and neither new alternative changes the position of
// elements before it.
model_statement ::= decorator_application* 'model' identifier template_parameter_list?
    ( (is_clause (';' | model_body)) | (extends_clause? model_body) ) {
  pin=2
  mixin="simpli.fyi.plugins.typespec.psi.impl.TypeSpecNamedElementMixin"
  implements="simpli.fyi.plugins.typespec.psi.TypeSpecNamedElement"
}

// Template parameter *lists* (declaring `T` in `model Page<T>`), now with an
// optional `extends`-bound and default (`<T extends string = "x">`) — M5c:
// kitchen-sink's `model Widget<T extends string>` needs the bound; resolving
// template *arguments* in type position (`Page<Pet>`) is also M5c (settled:
// plain recursive descent, no `<`/`>` ambiguity — see plan 03 M5c Approach).
template_parameter_list ::= '<' template_parameter (',' template_parameter)* '>' {
  pin=1
}

template_parameter ::= identifier ('extends' type_expression_)? ('=' type_expression_)? {
  mixin="simpli.fyi.plugins.typespec.psi.impl.TypeSpecNamedElementMixin"
  implements="simpli.fyi.plugins.typespec.psi.TypeSpecNamedElement"
}

// M5c: repointed from bare `qualified_name` at a full `type_expression_` (plan
// 03 M5c Approach) — an `extends`/`is` target can be any type expression, not
// only a plain reference (e.g. a union). `type_expression_` is `private`: the
// precedence-chain wrapper rules (`type_expression_` /
// `union_type_expression_` / `intersection_type_expression_` /
// `array_type_expression_` / `type_reference_`) are pure structural glue with
// no PSI-contract meaning of their own (same underscore-suffix convention as
// `model_member_`/`top_level_item_`) — inlined, they add ZERO extra tree
// nodes for the trivial "just a name" case, which is what keeps every M5b
// golden (`ModelSimple.txt` et al.) byte-identical after this repointing.
// Making any of them public would wrap even a bare `string` type in new
// composite nodes and silently break the M5b regression sweep.
extends_clause ::= 'extends' type_expression_ {
  pin=1
}

is_clause ::= 'is' type_expression_ {
  pin=1
}

model_body ::= '{' model_member_* '}' {
  pin=1
}

private model_member_ ::= model_property | model_spread | bad_model_member_token_

// Plan 04 M6b row 5 / ADR 0007 D6 follow-on: the reported defect-1 repro
// (`@@package(A.B, { name: "x" })`, `@dec({title: "x"})`) is a `model_expression`
// (`{ ... }`) whose *only* member has no trailing punctuation before the closing
// `}` — the dominant shape for an inline object type. `value_expression`'s
// unification with `type_expression_` alone does not make that repro parse
// clean: `model_property` still mandated a trailing `';'`, so this optional
// separator is pulled forward from M6b's own `member_separator_` design one
// milestone early — it is the piece that closes M6a's own acceptance probe,
// not scope creep past it. Loosening note (plan 04 M6b Risks): this also makes
// `model M { a: string b: string }` (no separator between distinct members)
// legal — an over-permissive grammar produces a wrong tree, an under-permissive
// one produces red squiggles on valid code, and only the second is visible to
// the user, so the loosening is accepted.
private member_separator_ ::= ';' | ','

// ADR 0006 D6: same reasoning as `bad_top_level_token_` above — the
// property-loop choice does *not* use `recoverWhile`. A `recoverWhile`
// predicate here would face the identical trap: when `model_property`
// completely fails (e.g. a broken property missing `:`), its own `pin`
// mechanics roll it back with zero consumption, so the built-in
// eatMore/lastErrorPos skip can advance at most to the position of its own
// deepest failed variant — never far enough to reach a *second* broken
// member's leftover tokens (an orphan ';') — and if a fallback alternative is
// *also* added to make up the difference, `recoverWhile`'s post-success
// re-check spuriously flags the fallback's own successful single-token match
// as an error (verified empirically both here and for `top_level_item_`).
// This fallback alone — consume exactly one token that isn't `model_body`'s
// own closing '}', then let the loop retry — is what lets a later, otherwise
// well-formed property still parse as a proper `TypeSpecModelPropertyImpl`
// after an earlier broken one.
private bad_model_member_token_ ::= bad_model_member_guard_ (IDENTIFIER | STRING | NUMBER | KEYWORD | DECORATOR | ';' | '.' | ','
  | ':' | '<' | '>' | '=' | '&' | '|' | '?' | '!' | '+' | '-' | '*' | '/' | '(' | ')' | '[' | ']' | '...')

private bad_model_member_guard_ ::= !('}')

// Plan 04 M6b row 6: repointed from bare `qualified_name` to a full
// `type_expression_` so a spread can carry template arguments
// (`...Record<unknown>;` — 11 stdlib occurrences) the same way
// `model_property`'s type position already does; `type_expression_`'s
// `type_reference_` still collapses to a bare `qualified_name` node when there
// are no template args, so the plain-reference tree shape (`...Foo.Bar;`) is
// unchanged. The trailing `';'` becomes the optional `member_separator_?`
// (ADR 0007 primary-source facts: `ListKind.ModelProperties`'s tolerated `,`
// applies here too — `...Foo.Bar<T, U>,` inside a model body). The `'...'` pin
// is kept: it is still the point of no return for this alternative of
// `model_member_`.
model_spread ::= '...' type_expression_ member_separator_? {
  pin=1
}

// Pins at ':' (position 4, after the leading `decorator_application*` and the
// optional '?'), not at the identifier — ADR 0006 D6's example verbatim: a
// bare identifier alone is not yet the point of no return, the ':' is. M5c:
// the type is now a full `type_expression_` (repointed from bare
// `qualified_name`, plan 03 M5c Approach; `private`, see `extends_clause`'s
// comment above) and an optional default value (`= value_expression`) is
// added — kitchen-sink's `weight?: int32 = 10;` needs it. Plan 04 M6b: a
// leading `decorator_application*` is added — `@key id: string;` is the
// single most common non-trivial construct in the ph-cdm corpus (366
// occurrences) and previously failed to parse because `model_property` was
// the one decoratable rule that had no decorator prefix. Adding it shifts the
// pin: `decorator_application*` is one sequence element, so `':'` moves from
// position 3 to position 4 — `pin=4` below, not `pin=3` (ADR 0007 plan 04 M6b
// trap; a wrong pin here silently degrades error recovery without failing any
// test).
model_property ::= decorator_application* identifier '?'? ':' type_expression_ ('=' value_expression)? member_separator_? {
  pin=4
  mixin="simpli.fyi.plugins.typespec.psi.impl.TypeSpecNamedElementMixin"
  implements="simpli.fyi.plugins.typespec.psi.TypeSpecNamedElement"
}

// ADR 0004 D7.1: wraps exactly one name token, ordinary or backticked — the
// hand-written lexer returns the same IDENTIFIER token for `` `foo` `` as for
// `foo` (see _TypeSpecLexer.flex's backtick-identifier rules), so no separate
// token type is needed here; backtick stripping happens in
// TypeSpecNamedElementMixin.getName() (psi/TypeSpecPsiUtil.kt).
// `elementType=` avoids a constant-name collision in the generated TypeSpecTypes
// holder: the rule name "identifier" would otherwise generate the same
// `IDENTIFIER` constant name as the external IDENTIFIER token declared above —
// two different `IElementType` fields cannot share one Java field name. The
// generated PSI class name (`TypeSpecIdentifier`) is driven by the rule name,
// not by this attribute, so ADR 0004 D7.1's naming is unaffected.
identifier ::= IDENTIFIER {
  elementType="identifier_node"
}

// ADR 0004 D7.1: a dot-separated sequence of `identifier` nodes, used UNIFORMLY
// everywhere a name/type is referenced: using, namespace, extends, is, property
// types, spread. Per-segment nodes are what let `Foo.Bar` be navigated segment
// by segment later (M5.5); this milestone only builds the shape.
qualified_name ::= identifier ('.' identifier)*

// ============================================================================
// M5c — decorator applications, augment-decorator statements, coarse value
// literals (plan 03 M5c; ADR 0004 F6, D7.2).
// ============================================================================

// One lexer DECORATOR token (`@Ns.name`, ADR 0004 F6) wrapped in a PSI node.
// Attached as a *leading, repeatable* element inside each declaration rule that
// can be decorated (`namespace_statement`, `model_statement`, `op_statement`,
// `interface_statement`, `enum_statement`, `union_statement`, `alias_statement`,
// `scalar_statement`, `operation_parameter`) rather than split out of the token
// itself — splitting `@Ns.name` into namespace + name is a separate, breaking
// change to the M2/M3 lexer tests (ADR 0004 open question 1, owner's call, not
// this milestone's).
decorator_application ::= DECORATOR decorator_argument_list? {
  pin=1
}

decorator_argument_list ::= '(' (value_expression (',' value_expression)*)? ')' {
  pin=1
}

// `@@Ns.name(...)` — a distinct top-level STATEMENT (kitchen-sink's
// `@@doc(Widget.id, "the id");`), not a prefix on another declaration. Always
// has at least one argument (the target reference); the lexer already
// distinguishes `@@` (AUGMENT_DECORATOR) from `@` (DECORATOR), so there is no
// ambiguity with `decorator_application` above.
augment_decorator_statement ::= AUGMENT_DECORATOR '(' value_expression (',' value_expression)* ')' ';' {
  pin=1
}

// ADR 0007 D6 / plan 04 M6a: unified with `type_expression_`, per upstream
// TypeSpec's single `Expression` production that spans both type expressions
// and value literals. Previously this rule duplicated STRING/NUMBER/
// true/false/qualified_name (already covered by `type_expression_` via
// `literal_type` and `type_reference_`) and, critically, never reached
// `model_expression` (`{ ... }`) — so a brace model-expression decorator
// argument like `@@package(A.B, { name: "x" })` or `@dec({ title: "x" })`
// failed to parse even though upstream allows it. `object_literal` (`#{...}`)
// and `array_literal` (`#[...]`) stay ordered first: they are lexed as
// distinct HASH_BRACE/HASH_BRACKET tokens so there is no real ambiguity with
// `type_expression_`'s `model_expression`/`tuple_expression`, but ordered
// choice makes the intent explicit.
value_expression ::= object_literal | array_literal | type_expression_

// `#{ key: value, ... }` — the hand-written lexer already returns the whole
// `#{` as one HASH_BRACE token (fixed text, unlike DECORATOR); the closing
// `}` is the ordinary RBRACE literal, same as every other brace-delimited rule
// in this grammar.
object_literal ::= '#{' (object_literal_member (',' object_literal_member)* ','?)? '}' {
  pin=1
}

object_literal_member ::= identifier ':' value_expression {
  pin=2
}

// `#[ value, ... ]` — same reasoning as `object_literal` above, with `#[`
// (HASH_BRACKET) / `]` (ordinary RBRACKET literal).
array_literal ::= '#[' (value_expression (',' value_expression)*)? ']' {
  pin=1
}

// ============================================================================
// M5c — type-expression precedence chain (plan 03 M5c Approach, settled;
// DO NOT re-litigate). Loosest to tightest: union `|` -> intersection `&` ->
// array `[]` postfix -> primary. Flat/associative, NOT left-recursive: TypeSpec
// itself defines `|`/`&` as flat repetition, so these are iterative repetition
// rules, not `expression ::= expression '|' expression` left recursion.
//
// Every rule in this chain (down to `type_reference_`) is `private`
// (trailing-underscore names, same convention as `model_member_` /
// `top_level_item_`): pure structural glue with no PSI-contract meaning of
// its own. Inlined, they add ZERO extra tree nodes for the trivial "just a
// name" case (e.g. `id: string;`) — which is what keeps every M5b golden
// (`ModelSimple.txt` et al.) byte-identical now that `model_property`,
// `extends_clause` and `is_clause` are repointed at this chain instead of a
// bare `qualified_name`. Making any of them public would wrap even a bare
// `string` type in new composite nodes and silently break the M5b regression
// sweep (plan 03 M5c "Full regression sweep").
// ============================================================================

private type_expression_ ::= union_type_expression_

// Leading `|` is legal (`| A | B`), hence the optional prefix.
private union_type_expression_ ::= '|'? intersection_type_expression_ ('|' intersection_type_expression_)*

// Leading `&` is legal (`& A & B`), hence the optional prefix.
private intersection_type_expression_ ::= '&'? array_type_expression_ ('&' array_type_expression_)*

// Postfix, repeatable: `Foo[][]`. There is no `T?` type suffix in TypeSpec —
// optionality is `model_property` / `operation_parameter`'s own `'?'?`, already
// implemented; do NOT add a `'?'` alternative here (plan 03 M5c Approach).
private array_type_expression_ ::= primary_type_expression ('[' ']')*

// Order matters only for `void`/`never`/`unknown`: the hand-written lexer
// keywordizes all three (`_TypeSpecLexer.flex` lines 103-105), so they can
// *never* reach `type_reference_`'s `qualified_name` (IDENTIFIER-only) path —
// omitting `intrinsic_type` here is the landmine that makes `op f(): void;`
// fail to parse, not the `<`/`>` ambiguity (plan 03 M5c Approach/Risks).
private primary_type_expression ::= intrinsic_type | type_reference_ | literal_type | paren_type_expression
  | model_expression | tuple_expression

intrinsic_type ::= 'void' | 'never' | 'unknown'

// `template_argument_list` is plain recursive descent, exactly like
// `template_parameter_list` — TypeSpec has no relational/comparison expression
// grammar competing for `<`/`>` in this position (verified against upstream
// `parser.ts`/`spec.emu.html`; plan 03 M5c Approach/Risks, now CLOSED). No
// external rules, no token remapping.
private type_reference_ ::= qualified_name template_argument_list?

template_argument_list ::= '<' template_argument (',' template_argument)* '>' {
  pin=1
}

// Named arguments first (ordered choice) so `Name<T=Foo>` resolves as a named
// argument, not a bare `type_expression_` that happens to start with an
// identifier followed by `=`.
private template_argument ::= (identifier '=' type_expression_) | type_expression_

// A string literal is `STRING (VALID_ESCAPE | INVALID_ESCAPE | STRING)*`, not
// a bare `STRING` — see the `VALID_ESCAPE`/`INVALID_ESCAPE` tokens= comment
// above for why an escape splits one source literal into several leaf tokens.
literal_type ::= STRING (VALID_ESCAPE | INVALID_ESCAPE | STRING)* | MULTILINE_STRING | NUMBER | 'true' | 'false'

paren_type_expression ::= '(' type_expression_ ')' {
  pin=1
}

// Coarse anonymous model type (`{ a: string }` in type position) — reuses
// `model_member_` (the same private member-loop `model_body` already uses), so
// its `model_property`/`model_spread`/recovery shape is identical, not
// reimplemented.
model_expression ::= '{' model_member_* '}' {
  pin=1
}

// Coarse tuple type (`[T, U]`). Distinguishable from `array_type_expression_`'s
// empty postfix `[]` by always having content between the brackets when it has
// any (an empty `[]` here and an empty postfix are structurally the same
// token pair; upstream treats a bare `[]` as an empty tuple, which this rule
// also accepts).
tuple_expression ::= '[' (type_expression_ (',' type_expression_)*)? ']' {
  pin=1
}

// ============================================================================
// M5c — remaining declaration kinds (plan 03 M5c; ADR 0004 D7.2 named-element
// contract: op, interface, enum + enum member, union + union variant, alias,
// scalar).
// ============================================================================

op_statement ::= decorator_application* 'op' identifier operation_parameter_list ':' type_expression_ ';' {
  pin=2
  mixin="simpli.fyi.plugins.typespec.psi.impl.TypeSpecNamedElementMixin"
  implements="simpli.fyi.plugins.typespec.psi.TypeSpecNamedElement"
}

operation_parameter_list ::= '(' (operation_parameter (',' operation_parameter)*)? ')' {
  pin=1
}

// Decorated parameters (`@path id: string`) — kitchen-sink's `op read(@path
// id: string): ...`. Not part of ADR 0004 D7.2's named-element contract (only
// `op`/`interface`/`enum`+member/`union`+variant/`alias`/`scalar` are), so no
// `mixin=`/`implements=` here — same precedent as `model_spread` in M5b.
operation_parameter ::= decorator_application* identifier '?'? ':' type_expression_ {
  pin=4
}

// `interface`'s members are bare operation signatures (`list(): Widget<string>
// []; get(id: string): Widget<string> | Error;`, kitchen-sink's `Store`) — NOT
// bare properties. The invalid `interface Store { values: #[1, 2, 3]; }` shape
// from `kitchen-sink.tsp` is explicitly not valid TypeSpec and is not
// accommodated here (plan 03 M5c "Kitchen-sink scope resolution").
interface_statement ::= decorator_application* 'interface' identifier template_parameter_list? interface_body {
  pin=2
  mixin="simpli.fyi.plugins.typespec.psi.impl.TypeSpecNamedElementMixin"
  implements="simpli.fyi.plugins.typespec.psi.TypeSpecNamedElement"
}

interface_body ::= '{' interface_member_* '}' {
  pin=1
}

private interface_member_ ::= interface_operation | bad_interface_member_token_

// ADR 0006 D6: identical fallback-alternative recovery technique as
// `bad_top_level_token_`/`bad_model_member_token_` — no `recoverWhile` (it
// traps on its own successful match re-check, plan 03 M5c "Recovery").
private bad_interface_member_token_ ::= bad_interface_member_guard_ (IDENTIFIER | STRING | NUMBER | KEYWORD
  | DECORATOR | ';' | '.' | ',' | ':' | '<' | '>' | '=' | '&' | '|' | '?' | '!' | '+' | '-' | '*' | '/' | '(' | ')'
  | '[' | ']' | '...')

private bad_interface_member_guard_ ::= !('}')

// Not part of ADR 0004 D7.2's named-element contract (interface operation
// *members* are deliberately excluded from the list — only the top-level `op`
// declaration is), so no `mixin=`/`implements=` here.
interface_operation ::= decorator_application* identifier operation_parameter_list ':' type_expression_ ';' {
  pin=3
}

enum_statement ::= decorator_application* 'enum' identifier enum_body {
  pin=2
  mixin="simpli.fyi.plugins.typespec.psi.impl.TypeSpecNamedElementMixin"
  implements="simpli.fyi.plugins.typespec.psi.TypeSpecNamedElement"
}

enum_body ::= '{' enum_member_* '}' {
  pin=1
}

private enum_member_ ::= enum_member | bad_enum_member_token_

// ADR 0006 D6: same reasoning as above. Separator commas between members are
// not part of `enum_member`'s own rule, so they simply fall through to the
// fallback alternative below (a harmless single-token "garbage" skip) and the
// loop continues to the next real member — identical in spirit to how
// `bad_model_member_token_` swallows leftover tokens after a broken property.
private bad_enum_member_token_ ::= bad_enum_member_guard_ (IDENTIFIER | STRING | NUMBER | KEYWORD | DECORATOR
  | ';' | '.' | ',' | ':' | '<' | '>' | '=' | '&' | '|' | '?' | '!' | '+' | '-' | '*' | '/' | '(' | ')' | '[' | ']'
  | '...')

private bad_enum_member_guard_ ::= !('}')

// Plain members (`Red`) and members with a value (`Red: "red"`) — kitchen-sink's
// `enum Color { Red: "red", Green: "green" }`. Plan 04 M6b: `ListKind.EnumMembers`
// is literally the same `ListKind` object as `ListKind.ModelProperties` (ADR
// 0007 primary-source facts), so `enum_member` gets the identical optional
// trailing `member_separator_?` treatment as `model_property` — previously the
// separator between enum members was only ever consumed one token at a time by
// `bad_enum_member_token_`'s fallback, which worked but attributed the comma to
// no real node. Adding it here does not move the pin: `member_separator_?` is
// appended after the existing sequence, so `identifier` stays at position 2.
enum_member ::= decorator_application* identifier (':' value_expression)? member_separator_? {
  pin=2
  mixin="simpli.fyi.plugins.typespec.psi.impl.TypeSpecNamedElementMixin"
  implements="simpli.fyi.plugins.typespec.psi.TypeSpecNamedElement"
}

union_statement ::= decorator_application* 'union' identifier union_body {
  pin=2
  mixin="simpli.fyi.plugins.typespec.psi.impl.TypeSpecNamedElementMixin"
  implements="simpli.fyi.plugins.typespec.psi.TypeSpecNamedElement"
}

union_body ::= '{' union_variant_* '}' {
  pin=1
}

private union_variant_ ::= union_variant | bad_union_variant_token_

// ADR 0006 D6: same reasoning as `bad_enum_member_token_` above.
private bad_union_variant_token_ ::= bad_union_variant_guard_ (IDENTIFIER | STRING | NUMBER | KEYWORD | DECORATOR
  | ';' | '.' | ',' | ':' | '<' | '>' | '=' | '&' | '|' | '?' | '!' | '+' | '-' | '*' | '/' | '(' | ')' | '[' | ']'
  | '...')

private bad_union_variant_guard_ ::= !('}')

// Plan 04 M6b follow-on (diagnosed against `corpus/real/booking/signals/rel-union.tsp`,
// which BASELINE.txt mislabelled row1 -- the true blocker is a bare `,` between union
// variants, row5's family): `ListKind.UnionVariants` is its own object upstream, distinct
// from `ListKind.ModelProperties`/`EnumMembers`, but has the identical shape --
// `delimiter: Semicolon, toleratedDelimiter: Comma, toleratedDelimiterIsValid: true`
// (verified against `@typespec/compiler`'s `parser.ts`, same primary source as ADR 0007's
// table) -- so `union_variant` gets the same optional trailing `member_separator_?` as
// `model_property`/`enum_member`. Appended after the existing sequence, so the pin does
// not move: `':'` stays at position 3.
union_variant ::= decorator_application* identifier ':' type_expression_ member_separator_? {
  pin=3
  mixin="simpli.fyi.plugins.typespec.psi.impl.TypeSpecNamedElementMixin"
  implements="simpli.fyi.plugins.typespec.psi.TypeSpecNamedElement"
}

// `alias Name = type_expression;` — kitchen-sink's `alias Greeting = "hi\nthere";`
// (a string *literal type*, reached via `type_expression` ->
// `literal_type` -> STRING).
alias_statement ::= decorator_application* 'alias' identifier template_parameter_list? '=' type_expression_ ';' {
  pin=2
  mixin="simpli.fyi.plugins.typespec.psi.impl.TypeSpecNamedElementMixin"
  implements="simpli.fyi.plugins.typespec.psi.TypeSpecNamedElement"
}

scalar_statement ::= decorator_application* 'scalar' identifier template_parameter_list? ('extends' type_expression_)? ';' {
  pin=2
  mixin="simpli.fyi.plugins.typespec.psi.impl.TypeSpecNamedElementMixin"
  implements="simpli.fyi.plugins.typespec.psi.TypeSpecNamedElement"
}
